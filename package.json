{
  "name": "panzerschokolade",
  "version": "0.0.0",
  "description": "blumenkraft",
  "private": true,
  "scripts": {
    "clean": "rm -rf public && rm -f static/style.css*",
    "dev:style": "sass style/main.scss static/style.css --watch",
    "build:style": "sass style/main.scss static/style.css --no-source-map --style compressed",
    "build:hugo": "hugo",
    "build:service": "cd service && GOOS=linux GOARCH=amd64 CGO_ENABLED=1 go build -trimpath -ldflags '-s -w' -o panzerservice .",
    "build": "npm run build:style && npm run build:hugo && npm run build:service",
    "start": "hugo server -D",
    "publish": "./publish.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/disktree/panzerschokolade.git"
  },
  "author": "tong@disktree.net",
  "license": "ISC",
  "homepage": "https://github.com/disktree/panzerschokolade/blob/master/README.md",
  "devDependencies": {
    "hugo-bin": "^0.146.0",
    "sass": "^1.92.0"
  },
  "hugo-bin": {
    "buildTags": "extended"
  }
}
