[Unit]
Description=Panzerschokolade Service
After=network.target

[Service]
Type=simple
WorkingDirectory=@DEPLOY_SERVICE_DIR@
ExecStart=@DEPLOY_SERVICE_DIR@/panzerservice
Restart=on-failure
RestartSec=5s
EnvironmentFile=@DEPLOY_SERVICE_DIR@/env

User=@DEPLOY_USER@
Group=@DEPLOY_USER@

# optional hardening
NoNewPrivileges=yes
PrivateTmp=yes
#ProtectSystem=full
#ProtectHome=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
